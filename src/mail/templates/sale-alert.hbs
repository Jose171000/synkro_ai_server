<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <title>Nueva venta — Synkro AI</title>
</head>
<body style="margin:0;padding:0;background:#F8F8F5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#F8F8F5;">Venta en {{channel}} por {{currency}} {{total}} — {{storeName}}.</div>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#F8F8F5" style="background:#F8F8F5;">
    <tr><td align="center" style="padding:32px 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:600px;">
        <tr><td style="background:#111111;border-radius:20px 20px 0 0;padding:36px 32px 32px;" align="center">
          <img src="{{logoUrl}}" width="64" height="64" alt="Synkro AI" style="display:block;border:0;border-radius:16px;margin:0 auto 20px;">
          <div style="font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#FCCB34;margin-bottom:10px;">{{storeName}}</div>
          <div style="font-size:26px;line-height:1.25;font-weight:800;color:#FFFFFF;">¡Nueva venta en {{channel}}!</div>
        </td></tr>
        <tr><td style="background:#FFFFFF;border:1px solid #ECEBE4;border-top:0;border-radius:0 0 20px 20px;padding:36px 32px 32px;">
          <p style="margin:0 0 16px;font-size:15px;line-height:1.65;color:#2B2B28;">¡Hola, <strong>{{name}}</strong>! Se acaba de registrar una venta en <strong>{{storeName}}</strong>.</p>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0 16px;">
            <tr><td align="center" style="background:#F8F8F5;border-radius:12px;padding:18px 12px;">
              <div style="font-size:32px;font-weight:800;color:#1E8E4E;line-height:1;">{{currency}} {{total}}</div>
              <div style="font-size:12px;color:#6B6B66;margin-top:6px;">pedido {{orderNumber}} · {{itemsCount}} {{#if itemsCount}}producto(s){{/if}}</div>
            </td></tr>
          </table>
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 8px;">
            {{#each items}}
            <tr>
              <td style="padding:10px 0;border-bottom:1px solid #ECEBE4;font-size:14px;color:#2B2B28;">{{quantity}} × {{title}}{{#if sku}}<br><span style="font-size:12px;color:#6B6B66;">SKU {{sku}}</span>{{/if}}</td>
              <td align="right" style="padding:10px 0;border-bottom:1px solid #ECEBE4;font-size:14px;color:#2B2B28;white-space:nowrap;">{{../currency}} {{unitPrice}}</td>
            </tr>
            {{/each}}
          </table>
          {{#if customerName}}<p style="margin:12px 0 0;font-size:14px;line-height:1.6;color:#2B2B28;">Comprador: <strong>{{customerName}}</strong></p>{{/if}}
          {{#if shipBy}}<p style="margin:4px 0 0;font-size:14px;line-height:1.6;color:#2B2B28;">Despachar antes del: <strong>{{shipBy}}</strong></p>{{/if}}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:28px auto 8px;">
            <tr><td align="center" bgcolor="#FCCB34" style="border-radius:10px;">
              <a href="{{dashboardUrl}}" target="_blank" style="display:inline-block;padding:14px 34px;font-size:15px;font-weight:700;color:#111111;text-decoration:none;border-radius:10px;">Ver la venta</a>
            </td></tr>
          </table>
        </td></tr>
        <tr><td align="center" style="padding:24px 16px 0;font-size:12px;line-height:1.7;color:#6B6B66;">
          <strong style="color:#111111;">Synkro AI</strong> · Recibes este aviso por ser parte del equipo de {{storeName}}.<br>
          Este es un correo automático, por favor no respondas a este mensaje.<br>
          &copy; {{year}} Synkro AI
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
