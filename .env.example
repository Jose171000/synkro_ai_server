# ── Base de datos ── #
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=synkro_db

# ── Auth ── #
JWT_SECRET=

# ── Entorno ── #
NODE_ENV=development
PORT=3001

# ── Frontend (CORS) ── #
FRONTEND_URL=http://localhost:8080

# ── Email (SMTP Gmail) ── #
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Synkro AI <noreply@synkroai.com>

# ── Brevo (API HTTP) ── #
# Si se define, los correos salen por la API de Brevo en vez de SMTP.
# Necesario en hostings que bloquean SMTP saliente (Railway).
BREVO_API_KEY=

# ── Cloudinary ── #
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── IA ── #
OPENAI_API_KEY=       # Para embeddings (text-embedding-3-small)
DEEPSEEK_API_KEY=     # Para generación de listings (deepseek-chat)

# ── Redis ── #
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
